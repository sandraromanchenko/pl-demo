# Copy to demo/aws.env to drive the three AWS hosts instead of local Docker.
# demo/run.sh sources this file, so every Makefile target and demo script
# switches at once. Delete (or empty) it to go back to local compose.
#
# Terraform can write this file for you, IPs filled in:
#   cd deploy/aws && terraform output -raw aws_env > ../../demo/aws.env
# `terraform output` also prints the same public IPs individually.

DEMO_HOST_DATA=ubuntu@DATA_PUBLIC_IP
DEMO_HOST_MODELS=ubuntu@MODELS_PUBLIC_IP
DEMO_HOST_APP=ubuntu@APP_PUBLIC_IP

# Where user_data cloned the repo on each host.
DEMO_REMOTE_DIR=/opt/pl-demo

# Add -i /path/to/key.pem for the instances' EC2 key pair if it is not in your
# ssh-agent. Absolute path or $HOME/... — a literal ~ is not expanded here.
#
# UserKnownHostsFile=/dev/null keeps re-created infra usable: the Elastic IPs
# come back attached to new hosts with new host keys, and a remembered key makes
# ssh refuse with REMOTE HOST IDENTIFICATION HAS CHANGED. Fine for throwaway
# demo hosts; it does mean no MITM protection, so don't copy this elsewhere.
DEMO_SSH_OPTS="-o UserKnownHostsFile=/dev/null -o StrictHostKeyChecking=accept-new -o LogLevel=ERROR"
