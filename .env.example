# pl-demo environment (copy to .env and edit).
#
# Local: `cp .env.example .env` then `docker compose up -d` (COMPOSE_PROFILES
# below enables all profiles; cross-host endpoints default to service names).
# AWS: each host uses a .env from env/<role>.env and runs one --profile.

# Enable all profiles locally so `docker compose up/down` needs no --profile.
COMPOSE_PROFILES=data,models,app

# ---- Images -----------------------------------------------------------------
# Auto-embedding (OPENAI_COMPATIBLE) ships in 1.70.4
MONGOD_IMAGE=percona/percona-server-mongodb:8.3.8
MONGOT_IMAGE=percona/percona-search-mongodb:1.70.4
# TEI publishes per-arch tags; on arm64 hosts use cpu-arm64-1.9
TEI_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-1.9

# ---- App config -------------------------------------------------------------
MONGO_DB=boardgames
MONGO_COLLECTION=games
TEXT_INDEX=text_index
# Models to enable (Ollama pulls + indexes): bge-small,nomic-embed-text,bge-m3
# Vector/hybrid use the first name in this list when the request omits `model`
EMBED_MODELS=bge-small

# Browser -> backend (baked into the bundle). On AWS: http://<app_public_ip>:8000
VITE_API_BASE=http://localhost:8000
FRONTEND_PORT=8081

# PMM server UI port on the app host (container serves TLS on 443)
PMM_HTTP_PORT=8443

# PMM login. `make prestart` re-asserts new password on the server
PMM_USERNAME=admin
PMM_PASSWORD=admin1

# SEED_DATA=false makes the seed service a no-op (data/indexes not created)
SEED_DATA=true