# pl-demo environment (copy to .env and edit).
#
# Local: `cp .env.example .env` then `docker compose up -d` (COMPOSE_PROFILES
# below enables all profiles; cross-host endpoints default to service names).
# AWS: each host uses a .env from env/<role>.env and runs one --profile.

# Enable all profiles locally so `docker compose up/down` needs no --profile.
COMPOSE_PROFILES=data,models,app

# ---- Images -----------------------------------------------------------------
# Auto-embedding (OPENAI_COMPATIBLE) ships in 1.70.4

# ---- App config -------------------------------------------------------------
MONGO_DB=boardgames
MONGO_COLLECTION=games
TEXT_INDEX=text_index
# Models to enable (Ollama pulls + indexes): bge-small,nomic-embed-text,bge-m3
# Vector/hybrid use the first name in this list when the request omits `model`
EMBED_MODELS=bge-small
# Talk, stage 2: `make swap-model` embeds questions with another 384-dimension model
# (snowflake-arctic-embed:22m by default) and `make restore-model` undoes it. The catalog is not touched.

# Browser -> backend (baked into the bundle). On AWS: http://<app_public_ip>:8000
VITE_API_BASE=http://localhost:8000
FRONTEND_PORT=8081

# PMM server UI port on the app host (container serves TLS on 443)
PMM_HTTP_PORT=8443

# PMM login. `make prestart` re-asserts new password on the server
PMM_USERNAME=admin
PMM_PASSWORD=admin1

# SEED_DATA=false makes the seed service a no-op (data/indexes not created)
SEED_DATA=true

# ---- OSMC talk stack (opt-in; not part of COMPOSE_PROFILES) ----------------
# make osmc-up && make osmc-seed && make os-up && make os-load && demo/talk.sh
# Search UI is the board-games app. vLLM never starts, unless you give the flag:
#   make osmc-rag-up LLM=1
# Default vLLM image is the CPU build. For a GPU host, osmc/compose-files.sh
# adds osmc/gpu.yml automatically when nvidia-smi works.
# VLLM_MODEL=Qwen/Qwen2.5-0.5B-Instruct
# VLLM_CPU_KVCACHE_SPACE=2
# CHURN_DOCS=20000
# GOLDEN_QUERIES=500
# RECALL_INTERVAL=10s

# ---- Offline pins: exact versions, nothing is pulled when the stack starts ---------------------
# `make offline-prepare` (needs the internet) fetches all of this. `make offline-check` verifies it
# without the internet. `make offline-up` starts the whole demo with no build and no pull.
MONGOD_IMAGE=percona/percona-server-mongodb:8.3.8
MONGOT_IMAGE=percona/percona-search-mongodb:1.70.4
PMM_SERVER_IMAGE=percona/pmm-server:3.10.0
PMM_CLIENT_IMAGE=percona/pmm-client:3.10.0
OPENSEARCH_IMAGE=opensearchproject/opensearch:3.9.0
OLLAMA_IMAGE=ollama/ollama:0.40.6
VLLM_IMAGE=vllm/vllm-openai-cpu:v0.32.0-x86_64
VLLM_GPU_IMAGE=vllm/vllm-openai:v0.32.0-x86_64-cu129
# Python tools (exporters, probes, seed, lab) on an image that already has pymongo and numpy.
SEED_IMAGE=pl-demo-pytools:1
# vLLM never contacts huggingface.co; the weights are in the vllm_hf volume.
HF_HUB_OFFLINE=1
