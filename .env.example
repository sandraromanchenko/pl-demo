# pl-demo environment (copy to .env and edit).
#
# Local: `cp .env.example .env` then `docker compose up -d` (COMPOSE_PROFILES
# below enables all profiles; cross-host endpoints default to service names).
# AWS: each host uses a .env from env/<role>.env and runs one --profile.

# Enable all profiles locally so `docker compose up/down` needs no --profile.
COMPOSE_PROFILES=data,models,app

# ---- Images -----------------------------------------------------------------
# Auto-embedding needs a mongot with the OPENAI_COMPATIBLE provider; override
# MONGOT_IMAGE with a dev build to get vector/hybrid search.
MONGOD_IMAGE=perconalab/percona-server-mongodb:8.3.4-1
MONGOT_IMAGE=perconalab/percona-search-mongodb:dev
# arm64 hosts: use the cpu-arm64-1.9 tag.
TEI_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-1.9
TEI_MODEL_ID=BAAI/bge-small-en-v1.5
OLLAMA_IMAGE=ollama/ollama:latest

# ---- Cross-host endpoints (defaults shown; override on AWS) ------------------
# backend + seed -> mongod (directConnection avoids the advertised-hostname gotcha).
MONGO_URI=mongodb://root:root@mongod:27017/?authSource=admin&directConnection=true
# mongot -> embedding backends (models host).
TEI_URL=http://tei:80
OLLAMA_URL=http://ollama:11434
# pmm-client (data host) -> pmm-server (app host).
PMM_SERVER=pmm-server
PMM_SERVER_PORT=443
PMM_USERNAME=admin
PMM_PASSWORD=admin

# ---- App config -------------------------------------------------------------
MONGO_DB=boardgames
MONGO_COLLECTION=games
TEXT_INDEX=text_index
# Models to enable (Ollama pulls + indexes): bge-small,nomic-embed-text,bge-m3.
EMBED_MODELS=bge-small
DEFAULT_MODEL=bge-small

# Browser -> backend (baked into the bundle). On AWS: http://<app_public_ip>:8000
VITE_API_BASE=http://localhost:8000
FRONTEND_PORT=8081

# PMM server UI port on the app host (container serves TLS on 443).
PMM_HTTP_PORT=8443

# Dataset to seed: full (data/boardgames.ndjson) or sample (20 games).
DATASET=sample

# SEED_DATA=false brings the stack up without loading data/indexes.
SEED_DATA=true
