# AWS DATA host (profile: data -> mongod, mongot, pmm-client). Needs the MODELS
# and APP host IPs. Terraform fills them in (or edit by hand).

# mongot build WITH the OPENAI_COMPATIBLE provider, else vector indexes are skipped.
MONGOT_IMAGE=percona/percona-search-mongodb:1.70.4

# -> MODELS host private IP (embedding backends).
TEI_URL=http://MODELS_PRIVATE_IP:8085
OLLAMA_URL=http://MODELS_PRIVATE_IP:11434

# -> APP host private IP (PMM server).
PMM_SERVER=APP_PRIVATE_IP
PMM_SERVER_PORT=8443
PMM_USERNAME=admin
PMM_PASSWORD=admin1

# mongod is local to this host.
MONGO_HOST=mongod
MONGO_ADMIN_USER=root
MONGO_ADMIN_PASSWORD=root
