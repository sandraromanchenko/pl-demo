# AWS MODELS host (profile: models -> tei, ollama). Self-contained; serves the
# embedding backends on 8085 (TEI) and 11434 (Ollama). Give it more CPU/RAM.

TEI_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-1.9
TEI_MODEL_ID=BAAI/bge-small-en-v1.5
OLLAMA_IMAGE=ollama/ollama:latest

# Must match the app host's EMBED_MODELS.
EMBED_MODELS=bge-small
