# AWS APP host (profile: app). Serves frontend + backend + PMM UI, runs seed;
# talks to the DATA host for Mongo. Terraform fills the IPs (or edit by hand).

# -> DATA host private IP (directConnection avoids the advertised-hostname issue).
MONGO_URI=mongodb://root:root@DATA_PRIVATE_IP:27017/?authSource=admin&directConnection=true

MONGO_DB=boardgames
MONGO_COLLECTION=games
TEXT_INDEX=text_index
EMBED_MODELS=bge-small

# Browser -> backend: app host PUBLIC IP (baked into the bundle).
VITE_API_BASE=http://APP_PUBLIC_IP:8000
FRONTEND_PORT=80

# PMM UI port (container serves TLS on 443).
PMM_HTTP_PORT=8443
# So PMM Server can scrape mongot on the data host (same hostname as locally).
DATA_PRIVATE_IP=DATA_PRIVATE_IP

SEED_DATA=true
