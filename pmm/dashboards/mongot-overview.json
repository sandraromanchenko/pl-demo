      "type": "row"
    },
    {
      "datasource": "Metrics",
      "description": "Index builds as they happen: INITIALIZING -> INITIAL_SYNC -> STEADY_STATE. Read this rather than the Building stat for short builds, because a small collection can finish between scrapes while the counters always record it.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 1,
            "showPoints": "never"
          },
          "min": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "id": 9,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": "Metrics",
          "expr": "sum by (fromState, toState) (increase(mongot_replicationIndexManager_transitionState_total[$__rate_interval]))",
          "legendFormat": "index: {{fromState}} -> {{toState}}",
          "refId": "A"
        },
        {
          "datasource": "Metrics",
          "expr": "sum by (fromState, toState) (increase(mongot_materializedViewGenerator_transitionState_total[$__rate_interval]))",
          "legendFormat": "matview: {{fromState}} -> {{toState}}",
          "refId": "B"
        }
      ],
      "title": "Index lifecycle",
      "type": "timeseries"
    },
    {
      "datasource": "Metrics",
