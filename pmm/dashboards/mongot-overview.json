    {
      "datasource": "Metrics",
      "description": "Whether mongot finished startup and is serving queries.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "red",
                  "text": "NOT READY"
                },
                "1": {
                  "color": "green",
                  "text": "SERVING"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text"
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "text": {
          "valueSize": 26
        },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "datasource": "Metrics",
          "expr": "max(mongot_readiness_lifecycleInitialized)",
          "legendFormat": "Mongot",
          "refId": "A"
        }
      ],
      "title": "Mongot",
      "type": "stat"
    },
    {
