# Copy to terraform.tfvars and edit. Sensible defaults are set, so you mainly
# need to set key_name.

# REQUIRED: an existing EC2 key pair in this region for SSH access. No default,
# so set it here (or pass TF_VAR_key_name / -var 'key_name=...') before apply.
key_name = "my-ec2-keypair"

# Private key for key_name. Set it unless the key is in your ssh-agent: the
# aws_env output then bakes `-i <path>` into demo/aws.env, which is what lets
# demo/run.sh (and every make target) SSH to the hosts.
# ssh_key_path = "/home/me/.ssh/my-ec2-keypair.pem"

# Where user_data clones the demo from (must be reachable from EC2).
repo_url    = "https://github.com/sandraromancnheko/pl-demo.git"
repo_branch = "main"

# AMI + network (override only if you know you need to).
# aws_region = "us-west-2"
# subnet_id  = "subnet-07f71e1a3117a32f9"
# ami        = "ami-01c276c8e835125d1"   # Ubuntu 24.04 (noble)
# billing_tag = "dev"

# mongot with auto-embedding (OPENAI_COMPATIBLE). Defaults to 1.70.4.
# mongot_image = "percona/percona-search-mongodb:1.70.4"

# Per-role sizing (models host larger for CPU embedding throughput).
# instance_type_data   = "t3.medium"
# instance_type_models = "t3.xlarge"
# instance_type_app    = "t3.medium"

# Start database, search, embedding backends and seed on boot (no SSH).
# Leave false for the live demo: images pulled, search not running.
# auto_start = true
